# Supabase Postgres. The publishable key is RLS-constrained and safe to share;
# the service_role key bypasses RLS and must stay secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=

# Solana ingestion via Helius. Without this the Solana source stays offline and
# the app falls back to the built-in simulator.
HELIUS_API_KEY=
# Optional: a dedicated RPC URL overrides the default mainnet endpoint.
HELIUS_RPC_URL=

# Ethereum ingestion via the BigQuery public dataset.
# Also requires: pip install google-cloud-bigquery
BIGQUERY_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Cost guardrails
MAX_BLOCKS_PER_PULL=200
BIGQUERY_MAX_BYTES=21474836480
